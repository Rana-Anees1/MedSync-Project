# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000
# Local MongoDB:      mongodb://127.0.0.1:27017/medsync
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>/medsync
MONGO_URI=mongodb://127.0.0.1:27017/medsync
# Use a long random string (at least 16 characters)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173,http://localhost:4173
# Folder for uploaded reports and wound photos
UPLOAD_DIR=uploads
# Daily readiness/recovery checks (cron syntax). Default: every day at 07:00
DAILY_CHECK_CRON=0 7 * * *
# Optional: URL of the Python AI service (leave empty to use the rule-based estimate)
AI_SERVICE_URL=
